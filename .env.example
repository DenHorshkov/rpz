# Django
DJANGO_SECRET_KEY=django-insecure-rpz-marketplace-local-dev-key-12345
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
# DJANGO_ENABLE_HTTPS=1   # вмикати тільки коли проєкт стоїть за HTTPS-проксі

# PostgreSQL
DATABASE_URL=sqlite:///db.sqlite3

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Groq (free LLM provider — get a key at https://console.groq.com/keys)
GROQ_API_KEY=gsk-replace-me
GROQ_MODEL=llama-3.3-70b-versatile
